 const edges=[{from:'S0',to:'S1',id:'PLAY'},{from:'S1',to:'O0',id:'ET1',type:'END_TURN'},{from:'O0',to:'O1',id:'DRAIN'},{from:'O1',to:'M0',id:'ET2',type:'END_TURN'}];
