 if(q.length||lines.length>=lim.maxLines){truncated=true;reasons.push(REASON.SEARCH_TRUNCATED);}return {lines,nodes,duplicates,cycles,memoHits,unknownCount,truncated,reasonCodes:uniq(reasons)};}
 function responseType(line,hasUnknown){const real=(line.actions||[]).filter(a=>a.actionType!=='END_TURN');if(hasUnknown&&real.length===0)return RESPONSE_TYPE.UNKNOWN_HAND_DEPENDENT_RESPONSE;if(real.length===0)return RESPONSE_TYPE.NO_KNOWN_RESPONSE;return RESPONSE_TYPE.OBSERVED_AVAILABLE_RESPONSE;}
