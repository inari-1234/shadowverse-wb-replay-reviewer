ray.isArray(sequence)?sequence:Array.isArray(sequence&&sequence.actions)?sequence.actions:[],path=[],events=[];let s=initial,status=STATUS.OK,reasons=[];for(const a of actions){if(!a||a.legality!=='LEGAL'){status=STATUS.UNRESOLVED;reasons.push(REASON.ILLEGAL_SEQUENCE_INPUT);break;}const before=s,ap=E.applyAction(s,a);if(ap&&ap.state)events.push(...outcomeEvents(before,ap.state,{phase:'INPUT_SEQUENCE',action:a}));path.push({actionId:a.actionId,actionType:a.actionType,status:ap&&ap.status||STATUS.ERROR,state:ap&&ap.state?ref(sid(ap.state),fp(ap.state)):null,reasonCodes:clone(ap&&ap.reasonCodes||[])});if(!ap||!ap.state){status=ap&&ap.status||STATUS.ERROR;reasons.push(...(ap&&ap.reasonCodes||[REASON.UNRESOLVED_OUTCOME]));break;}s=ap.state;status=ap.status||STATUS.OK;reasons.push(...(ap.reasonCodes||[]));if(status===STATUS.TERMINAL)break;if([STATUS.UNRESOLVED,STATUS.INVALID,STATUS.ERROR].includes(status))break;}return {status,state:s,actions,path,events,reasonCodes:uniq(reasons)};}
