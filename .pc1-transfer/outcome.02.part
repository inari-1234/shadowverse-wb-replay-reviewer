 function expandTurn(start,actorId,limits,phase,graph,parentNodeId){const lim={maxDepth:limits.maxDepth??cfg.maxDepth,maxNodes:limits.maxNodes??cfg.maxNodes,maxBranches:limits.maxBranches??cfg.maxBranches,maxLines:limits.maxLines??cfg.maxBranches},budget=limits._budget||{nodes:0,maxNodes:lim.maxNodes},memo=limits._memo||new Map();const q=[{state:start,actions:[],events:[],depth:0,path:new Set([fp(start)]),parentNodeId}],seen=new Map([[fp(start),0]]),lines=[];let nodes=0,duplicates=0,cycles=0,memoHits=0,unknownCount=0,truncated=false;const reasons=[];while(q.length&&lines.length<lim.maxLines){const n=q.shift();if(nodes>=lim.maxNodes||budget.nodes>=budget.maxNodes){truncated=true;reasons.push(REASON.NODE_LIMIT);break;}const tm=terminal(n.state);if(tm.terminal){lines.push({...n,status:STATUS.TERMINAL,stopReason:REASON.TERMINAL_STATE,terminalStatus:tm});continue;}if(active(n.state)!==actorId){lines.push({...n,status:STATUS.OK,stopReason:'TURN_PASSED',terminalStatus:tm});continue;}if(n.depth>=lim.maxDepth){truncated=true;reasons.push(REASON.DEPTH_LIMIT);lines.push({...n,status:STATUS.LIMIT,stopReason:REASON.DEPTH_LIMIT,terminalStatus:tm});continue;}const mk=`${fp(n.state)}|${n.depth}`;let g=memo.get(mk);if(g){memoHits++;reasons.push(REASON.MEMO_HIT);}else{g=E.generateLegalActions(n.state,{sequenceDepth:n.depth});if(memo.size<cfg.maxMemoEntries)memo.set(mk,g);}const ur=unknownReasons(g);unknownCount+=ur.length;if(g.status!=='OK'){lines.push({...n,status:STATUS.UNRESOLVED,stopReason:g.status,reasonCodes:uniq([...(n.reasonCodes||[]),...ur]),terminalStatus:tm});continue;}let acts=g.actions||[];if(acts.length>lim.maxBranches){acts=acts.slice(0,lim.maxBranches);truncated=true;reasons.push(REASON.BRANCH_LIMIT);}if(!acts.length){lines.push({...n,status:ur.length?STATUS.UNRESOLVED:STATUS.OK,stopReason:'NO_ACTION',reasonCodes:ur,terminalStatus:tm});continue;}for(const a of acts){if(nodes>=lim.maxNodes||budget.nodes>=budget.maxNodes||lines.length>=lim.maxLines)break;nodes++;budget.