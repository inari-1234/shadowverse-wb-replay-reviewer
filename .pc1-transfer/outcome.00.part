 function authority(s){if(typeof R.getAuthorityStatus!=='function')return {status:'RESOLVED',reasons:[]};const x=R.getAuthorityStatus(s)||{};return {status:x.status||'RESOLVED',reasons:uniq(x.reasons)};}
 function terminal(s){const f=typeof R.getTerminalStatus==='function'?R.getTerminalStatus.bind(R):typeof A.getTerminalStatus==='function'?A.getTerminalStatus.bind(A):null;if(!f)return {terminal:false,status:'UNKNOWN',reasons:[REASON.UNRESOLVED_OUTCOME]};const x=f(s);if(x===true)return {terminal:true,status:'TERMINAL',reasons:[REASON.TERMINAL_STATE]};if(!x||x===false)return {terminal:false,status:'ACTIVE',reasons:[]};if(x.status==='UNKNOWN'||x.status==='UNRESOLVED')return {terminal:false,status:x.status,reasons:uniq(x.reasons||[REASON.UNRESOLVED_OUTCOME])};return {terminal:x.terminal===true,status:x.terminal?'TERMINAL':'ACTIVE',winner:x.winner??null,loser:x.loser??null,reasons:uniq(x.reasons||(x.terminal?[REASON.TERMINAL_STATE]:[]))};}
 function followerSummary(x){return {instanceId:x.instanceId??x.id??null,cardId:x.cardId??null,kind:x.kind??null,attack:num(x.attack),defense:num(x.defense??x.hp),ward:x.ward===true,stealth:x.stealth===true||x.ambush===true,untargetable:x.targetable===false,canAttack:x.canAttack===true,canAttackLeader:x.canAttackLeader!==false,summonedThisTurn:x.summonedThisTurn===true,evolved:x.evolved===true,superEvolved:x.superEvolved===true,oncePerTurnUsed:x.oncePerTurnUsed===true||x.abilityUsed===true,removalResistance:clone(x.removalResistance??x.resistance??null),temporaryDuration:clone(x.temporaryDuration??x.duration??null)};}
 function boardSummary(v){const field=Array.isArray(v&&v.field)?v.field:[],entries=field.map(followerSummary);return {followerCount:entries.filter(x=>x.kind==='FOLLOWER'||x.kind==null).length,totalAttack:entries.reduce((n,x)=>n+(x.attack||0),0),totalDefense:entries.reduce((n,x)=>n+(x.defense||0),0),wardCount:entries.filter(x=>x.ward).length,stealthCount:ent